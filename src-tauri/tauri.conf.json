{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IP Switch",
  "version": "1.0.0",
  "mainBinaryName": "IP Switch",
  "identifier": "com.ipswitch.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "IP Switch",
        "width": 820,
        "height": 680,
        "minWidth": 680,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
